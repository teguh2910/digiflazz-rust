# Digiflazz credentials for local examples/tests. Copy to `.env` and fill in.
# Never commit `.env`; it is gitignored.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_DEVELOPMENT_KEY=
DIGIFLAZZ_PRODUCTION_KEY=
# development (default) or production
DIGIFLAZZ_ENV=development

# digiflazz-service
# The service uses a single key; set this to the development or production key.
DIGIFLAZZ_API_KEY=
# Bearer token clients must present. Minimum 16 characters.
SERVICE_API_TOKEN=
PORT=8080
PRICE_LIST_TTL_SECS=300
# Browser origins allowed to call the API, comma separated, exact match.
# Leave empty to reject all cross-origin requests (server-to-server only).
CORS_ORIGINS=
